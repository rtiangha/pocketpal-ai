+  # NOTE: MobileCoreServices and UniformTypeIdentifiers are required when
+  # building with use_frameworks! :linkage => :dynamic. ImagePickerManager.mm
+  # and ImagePickerUtils.mm use UTType symbols (kUTTypeImage/JPEG/Movie,
