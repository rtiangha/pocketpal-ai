@@ -34,9 +34,19 @@ Pod::Spec.new do |s|
 
   s.libraries = 'sqlite3'
 
-  # NOTE: This dependency doesn't seem to be needed anymore (tested on RN 0.66, 0.71), file an issue
-  # if this causes issues for you
-  # s.dependency "React-jsi"
+  # NOTE: React-jsi and React-hermes are required when building with
+  # use_frameworks! :linkage => :dynamic. Without them, WatermelonDB links
+  # with no JSI provider and fails with "Undefined symbols for architecture
+  # arm64: facebook::jsi::*". React-jsi alone is NOT enough: with Hermes
+  # enabled its jsi.cpp is excluded from the pod (the implementation lives
+  # in the Hermes engine), so React-jsi supplies only the JSI headers and
+  # links no JSI symbols. The implementation is in hermesvm.framework,
+  # reached through React-hermes (which depends on hermes-engine). Static
+  # linkage used to resolve JSI at the final app link, which is why
+  # React-jsi was commented out upstream after RN 0.66/0.71 — it is not
+  # optional anymore.
+  s.dependency "React-jsi"
+  s.dependency "React-hermes"
 
   # NOTE: NPM-vendored @nozbe/simdjson must be used, not the CocoaPods version
   s.dependency "simdjson"
