+  // ---------------------------------------------------------------------------------------------
+  // Custom Vulkan driver (Turnip) support.
+  //
+  // The app (JS side) controls it through plain files under <filesDir>/turnip/:
+  //   enabled      marker file; present = the user turned the custom driver on
+  //   driver_name  file name of the driver library inside that directory (written by the app for
+  //                a raw .so import, or by installPendingTurnipImport for a zip)
+  //   import.zip   a driver package (meta.json + library) waiting to be unpacked
+  //   import_error.txt  why the last package import failed, if it did
+  // Changes take effect the next time the app starts, because the Vulkan variant is chosen here, once.
+  // ---------------------------------------------------------------------------------------------
+  private static final String TURNIP_DIR_NAME = "turnip";
+
+  private static String readSmallFile(File file) throws IOException {
+    try (BufferedReader reader = new BufferedReader(new FileReader(file))) {
+      String line = reader.readLine();
+      return line == null ? "" : line.trim();
+    }
+  }
+
+  private static void writeTurnipImportError(File errorFile, String message) {
+    try (java.io.FileWriter w = new java.io.FileWriter(errorFile, false)) {
+      w.write(message);
+    } catch (Throwable t) {
+      Log.w(TAG, "Could not write Turnip import error", t);
+    }
+    Log.w(TAG, message);
+  }
+
+  private static void installPendingTurnipImport(File dir) {
+    File zip = new File(dir, "import.zip");
+    if (!zip.exists()) return;
+    File nameFile = new File(dir, "driver_name");
+    File errorFile = new File(dir, "import_error.txt");
+    try {
+      String libraryName = null;
+      byte[] meta = null;
+      try (java.util.zip.ZipInputStream zin = new java.util.zip.ZipInputStream(new java.io.FileInputStream(zip))) {
+        java.util.zip.ZipEntry entry;
+        while ((entry = zin.getNextEntry()) != null) {
+          if (!entry.isDirectory() && new File(entry.getName()).getName().equals("meta.json")) {
+            java.io.ByteArrayOutputStream bos = new java.io.ByteArrayOutputStream();
+            byte[] buf = new byte[8192];
+            int n;
+            while ((n = zin.read(buf)) != -1) bos.write(buf, 0, n);
+            meta = bos.toByteArray();
+            break;
+          }
+        }
+      }
+      if (meta == null) {
+        writeTurnipImportError(errorFile, "Driver package has no meta.json");
+        return;
+      }
+      libraryName = new org.json.JSONObject(new String(meta, "UTF-8")).optString("libraryName", null);
+      if (libraryName == null || libraryName.isEmpty() || libraryName.contains("/")) {
+        writeTurnipImportError(errorFile, "Driver package has no usable meta.json libraryName");
+        return;
+      }
+      boolean extracted = false;
+      try (java.util.zip.ZipInputStream zin = new java.util.zip.ZipInputStream(new java.io.FileInputStream(zip))) {
+        java.util.zip.ZipEntry entry;
+        while ((entry = zin.getNextEntry()) != null) {
+          if (entry.isDirectory() || !new File(entry.getName()).getName().equals(libraryName)) continue;
+          File out = new File(dir, libraryName);
+          try (FileOutputStream fos = new FileOutputStream(out)) {
+            byte[] buf = new byte[65536];
+            int n;
+            while ((n = zin.read(buf)) != -1) fos.write(buf, 0, n);
+          }
+          out.setReadable(true, true);
+          out.setExecutable(true, true);
+          extracted = true;
+          break;
+        }
+      }
+      if (extracted) {
+        // Only now replace the previously installed driver: a bad package must not
+        // leave the user with no driver.
+        try (FileOutputStream metaOut = new FileOutputStream(new File(dir, "meta.json"))) {
+          metaOut.write(meta);
+        }
+        try (java.io.FileWriter w = new java.io.FileWriter(nameFile, false)) {
+          w.write(libraryName);
+        }
+        //noinspection ResultOfMethodCallIgnored
+        errorFile.delete();
+        Log.i(TAG, "Installed Turnip driver " + libraryName + " from import.zip");
+      } else {
+        writeTurnipImportError(errorFile, "Driver package does not contain " + libraryName);
+      }
+    } catch (Throwable t) {
+      Log.w(TAG, "Failed to install Turnip driver package", t);
+      writeTurnipImportError(errorFile, "Could not install the driver package: " + t.getMessage());
+    } finally {
+      //noinspection ResultOfMethodCallIgnored
+      zip.delete();
+    }
+  }
+
+  /** @return true when the Vulkan variant with the custom driver should be loaded. */
+  private static boolean prepareTurnipDriver(ReactApplicationContext context) {
+    try {
+      File dir = new File(context.getFilesDir(), TURNIP_DIR_NAME);
+      if (!new File(dir, "enabled").exists()) return false;
+
+      installPendingTurnipImport(dir);
+
+      File nameFile = new File(dir, "driver_name");
+      if (!nameFile.exists()) {
+        Log.w(TAG, "Turnip is enabled but no driver is installed");
+        return false;
+      }
+      String name = readSmallFile(nameFile);
+      File driver = new File(dir, name);
+      if (name.isEmpty() || name.contains("/") || !driver.isFile()) {
+        Log.w(TAG, "Turnip driver file is missing: " + driver);
+        return false;
+      }
+      driver.setReadable(true, true);
+      driver.setExecutable(true, true);
+
+      File tmp = new File(context.getCacheDir(), "turnip-tmp");
+      //noinspection ResultOfMethodCallIgnored
+      tmp.mkdirs();
+
+      android.system.Os.setenv("RNLLAMA_VK_DRIVER_DIR", dir.getAbsolutePath(), true);
+      android.system.Os.setenv("RNLLAMA_VK_DRIVER_NAME", name, true);
+      android.system.Os.setenv("RNLLAMA_VK_HOOK_DIR", context.getApplicationInfo().nativeLibraryDir, true);
+      android.system.Os.setenv("RNLLAMA_VK_TMP_DIR", tmp.getAbsolutePath(), true);
+      android.system.Os.setenv("RNLLAMA_VK_PIPELINE_CACHE", new File(dir, "pipeline_cache.bin").getAbsolutePath(), true);
+      // Extra variables from the app's Settings screen (<filesDir>/turnip/env, KEY=VALUE per line).
+      // RNLLAMA_VK_SELFTEST is one-shot: it is removed from the file once applied, so a self-test that
+      // takes the GPU driver down does not turn into a crash on every launch.
+      File envFile = new File(dir, "env");
+      if (envFile.isFile()) {
+        java.util.List<String> keptLines = new java.util.ArrayList<>();
+        boolean consumedSelfTest = false;
+        try (BufferedReader envReader = new BufferedReader(new FileReader(envFile))) {
+          String envLine;
+          while ((envLine = envReader.readLine()) != null) {
+            String trimmed = envLine.trim();
+            int eq = trimmed.indexOf('=');
+            if (trimmed.isEmpty() || trimmed.startsWith("#") || eq <= 0) {
+              keptLines.add(envLine);
+              continue;
+            }
+            String key = trimmed.substring(0, eq).trim();
+            String value = trimmed.substring(eq + 1).trim();
+            if (!key.matches("(GGML|RNLLAMA)_[A-Z0-9_]+")) {
+              Log.w(TAG, "Ignoring environment variable " + key + " (only GGML_* and RNLLAMA_* are allowed)");
+              keptLines.add(envLine);
+              continue;
+            }
+            android.system.Os.setenv(key, value, true);
+            Log.i(TAG, "Environment from turnip/env: " + key + "=" + value);
+            if (key.equals("RNLLAMA_VK_SELFTEST")) {
+              consumedSelfTest = true;  // do not keep it for the next launch
+            } else {
+              keptLines.add(envLine);
+            }
+          }
+        } catch (Throwable t) {
+          Log.w(TAG, "Could not read turnip/env", t);
+          consumedSelfTest = false;
+        }
+        if (consumedSelfTest) {
+          try (java.io.FileWriter envWriter = new java.io.FileWriter(envFile, false)) {
+            envWriter.write(android.text.TextUtils.join("\n", keptLines));
+          } catch (Throwable t) {
+            Log.w(TAG, "Could not update turnip/env", t);
+          }
+        }
+      }
+      // No automatic Vulkan workarounds: only the environment box applies.
+      // An empty box runs the driver as it ships; the Safe preset sets the
+      // known workarounds explicitly.
+      Log.i(TAG, "Custom Vulkan driver enabled: " + driver + " (" + driver.length() + " bytes)");
+      StringBuilder hooks = new StringBuilder();
+      for (String hook : new String[] {"libhook_impl.so", "libmain_hook.so", "libfile_redirect_hook.so", "libgsl_alloc_hook.so"}) {
+        File hookFile = new File(context.getApplicationInfo().nativeLibraryDir, hook);
