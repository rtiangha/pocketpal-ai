diff --git a/node_modules/llama.rn/android/src/main/rnllama/vk-selftest.cpp b/node_modules/llama.rn/android/src/main/rnllama/vk-selftest.cpp
new file mode 100644
index 0000000..1afcfd1
--- /dev/null
+++ b/node_modules/llama.rn/android/src/main/rnllama/vk-selftest.cpp
@@ -0,0 +1,599 @@
+// GPU self-test for the Vulkan variant (custom Turnip driver), ported from the OfflineLLM project.
+//
+// Runs a few ggml ops on the CPU backend and on the Vulkan backend with identical deterministic
+// inputs and reports the normalised error of the GPU result against the CPU reference. It pinpoints
+// which op / weight type a broken driver (or shader) gets wrong.
+//
+// Triggered from ggml-vulkan.cpp when the first Vulkan backend is created and the environment
+// variable RNLLAMA_VK_SELFTEST is set (the app's Settings screen can set it). The report goes to
+// logcat (tag RNLlamaVk) and to <RNLLAMA_VK_DRIVER_DIR>/selftest.txt, which the Settings screen shows.
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <android/log.h>
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <functional>
+#include <unistd.h>
+#include <string>
+#include <vector>
+
+namespace {
+
+struct SelfTestCase {
+    std::string name;
+    std::function<ggml_tensor *(ggml_context *, std::vector<ggml_tensor *> &)> build;
+    bool heavy = false;  // realistic (large) sizes: only run at RNLLAMA_VK_SELFTEST=2, may hang a weak GPU driver
+};
+
+void fillTensorDeterministic(ggml_tensor * t, uint32_t seed) {
+    const size_t n = (size_t) ggml_nelements(t);
+    if (t->type == GGML_TYPE_I32) {
+        // row indices for get_rows: always inside the 64 rows of the weight tensor
+        std::vector<int32_t> idx(n);
+        for (size_t i = 0; i < n; i++) {
+            idx[i] = (int32_t) ((i * 5 + 3) % 64);
+        }
+        ggml_backend_tensor_set(t, idx.data(), 0, n * sizeof(int32_t));
+        return;
+    }
+    if (t->type == GGML_TYPE_I64) {
+        // row indices for set_rows: unique and inside the 64 rows of the destination
+        std::vector<int64_t> idx(n);
+        for (size_t i = 0; i < n; i++) {
+            idx[i] = (int64_t) ((i * 3 + 1) % 64);
+        }
+        ggml_backend_tensor_set(t, idx.data(), 0, n * sizeof(int64_t));
+        return;
+    }
+    std::vector<float> f(n);
+    uint32_t s = seed * 2654435761u + 12345u;
+    for (size_t i = 0; i < n; i++) {
+        s = s * 1664525u + 1013904223u;
+        f[i] = (float) ((s >> 8) & 0xFFFF) / 32768.0f - 1.0f;  // [-1, 1)
+    }
+    if (t->type == GGML_TYPE_F32) {
+        ggml_backend_tensor_set(t, f.data(), 0, n * sizeof(float));
+    } else if (t->type == GGML_TYPE_F16) {
+        std::vector<ggml_fp16_t> h(n);
+        ggml_fp32_to_fp16_row(f.data(), h.data(), (int64_t) n);
+        ggml_backend_tensor_set(t, h.data(), 0, n * sizeof(ggml_fp16_t));
+    } else {
+        std::vector<uint8_t> q(ggml_nbytes(t));
+        ggml_quantize_chunk(t->type, f.data(), q.data(), 0, ggml_nrows(t), t->ne[0], nullptr);
+        ggml_backend_tensor_set(t, q.data(), 0, q.size());
+    }
+}
+
+bool readResultAsFloat(ggml_tensor * result, std::vector<float> & out) {
+    const size_t n = (size_t) ggml_nelements(result);
+    std::vector<uint8_t> raw(ggml_nbytes(result));
+    ggml_backend_tensor_get(result, raw.data(), 0, raw.size());
+    out.resize(n);
+    if (result->type == GGML_TYPE_F32) {
+        memcpy(out.data(), raw.data(), n * sizeof(float));
+    } else if (result->type == GGML_TYPE_F16) {
+        ggml_fp16_to_fp32_row((const ggml_fp16_t *) raw.data(), out.data(), (int64_t) n);
+    } else {
+        const ggml_type_traits * traits = ggml_get_type_traits(result->type);
+        if (traits == nullptr || traits->to_float == nullptr) {
+            return false;
+        }
+        traits->to_float(raw.data(), out.data(), (int64_t) n);
+    }
+    return true;
+}
+
+// Returns 1 = computed, 0 = failed, -1 = op not supported by this backend.
+int runSelfTestCase(ggml_backend_t backend, const SelfTestCase & c, std::vector<float> & out) {
+    ggml_init_params ip = {ggml_tensor_overhead() * 32 + ggml_graph_overhead(), nullptr, true};
+    ggml_context * ctx = ggml_init(ip);
+    if (ctx == nullptr) {
+        return 0;
+    }
+    std::vector<ggml_tensor *> inputs;
+    ggml_tensor * result = c.build(ctx, inputs);
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, result);
+    int status = 0;
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, backend);
+    if (buf != nullptr) {
+        if (!ggml_backend_supports_op(backend, result)) {
+            status = -1;
+        } else {
+            for (size_t i = 0; i < inputs.size(); i++) {
+                fillTensorDeterministic(inputs[i], (uint32_t) (1 + i));
+            }
+            if (ggml_backend_graph_compute(backend, gf) == GGML_STATUS_SUCCESS) {
+                status = readResultAsFloat(result, out) ? 1 : 0;
+            }
+        }
+        ggml_backend_buffer_free(buf);
+    }
+    ggml_free(ctx);
+    return status;
+}
+
+std::vector<SelfTestCase> makeSelfTestCases() {
+    std::vector<SelfTestCase> cases;
+    auto unary = [&](const char * name, std::function<ggml_tensor *(ggml_context *, ggml_tensor *)> op) {
+        cases.push_back({name, [op](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                             ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 512, 8);
+                             in = {a};
+                             return op(ctx, a);
+                         }});
+    };
+    auto binary = [&](const char * name,
+                      std::function<ggml_tensor *(ggml_context *, ggml_tensor *, ggml_tensor *)> op) {
+        cases.push_back({name, [op](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                             ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 512, 8);
+                             ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 512, 8);
+                             in = {a, b};
+                             return op(ctx, a, b);
+                         }});
+    };
+    binary("add F32", [](ggml_context * c, ggml_tensor * a, ggml_tensor * b) { return ggml_add(c, a, b); });
+    binary("mul F32", [](ggml_context * c, ggml_tensor * a, ggml_tensor * b) { return ggml_mul(c, a, b); });
+    unary("silu F32", [](ggml_context * c, ggml_tensor * a) { return ggml_silu(c, a); });
+    unary("rms_norm F32", [](ggml_context * c, ggml_tensor * a) { return ggml_rms_norm(c, a, 1e-5f); });
+    unary("soft_max F32", [](ggml_context * c, ggml_tensor * a) { return ggml_soft_max(c, a); });
+
+    // Short convolution as used by the LFM hybrid models: sx [d_conv-1+n_t, d_inner, n_s], c [d_conv, d_inner].
+    cases.push_back({"ssm_conv F32", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * sx = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 3 + 8, 128, 1);
+                         ggml_tensor * c = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 4, 128);
+                         in = {sx, c};
+                         return ggml_ssm_conv(ctx, sx, c);
+                     }});
+
+
+    // ---- ops a transformer / hybrid model graph uses around the matrix multiplications ----
+    cases.push_back({"add broadcast F32", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 512, 8);
+                         ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 512, 1);
+                         in = {a, b};
+                         return ggml_add(ctx, a, b);
+                     }});
+    unary("scale F32", [](ggml_context * c, ggml_tensor * a) { return ggml_scale(c, a, 0.125f); });
+    unary("clamp F32", [](ggml_context * c, ggml_tensor * a) { return ggml_clamp(c, a, -0.5f, 0.5f); });
+    unary("sum_rows F32", [](ggml_context * c, ggml_tensor * a) { return ggml_sum_rows(c, a); });
+    unary("l2_norm F32", [](ggml_context * c, ggml_tensor * a) { return ggml_l2_norm(c, a, 1e-6f); });
+    cases.push_back({"swiglu F32", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 1024, 8);
+                         in = {a};
+                         return ggml_swiglu(ctx, a);
+                     }});
+    cases.push_back({"concat F32", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 64, 8);
+                         ggml_tensor * b = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 32, 8);
+                         in = {a, b};
+                         return ggml_concat(ctx, a, b, 0);
+                     }});
+    cases.push_back({"cont(permute) F32", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * a = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 64, 4, 8);
+                         in = {a};
+                         return ggml_cont(ctx, ggml_permute(ctx, a, 0, 2, 1, 3));
+                     }});
+    cases.push_back({"cpy F32->F16", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 512, 8);
+                         ggml_tensor * dst = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, 512, 8);
+                         in = {a};
+                         return ggml_cpy(ctx, a, dst);
+                     }});
+    for (int mode : {GGML_ROPE_TYPE_NORMAL, GGML_ROPE_TYPE_NEOX}) {
+        cases.push_back({mode == GGML_ROPE_TYPE_NEOX ? "rope neox F32" : "rope normal F32",
+                         [mode](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                             ggml_tensor * a = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 64, 8, 4);  // head dim, heads, tokens
+                             ggml_tensor * pos = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 4);
+                             in = {a, pos};
+                             return ggml_rope_ext(ctx, a, pos, nullptr, 64, mode, 4096, 10000.0f, 1.0f, 0.0f, 1.0f,
+                                                  32.0f, 1.0f);
+                         }});
+    }
+    cases.push_back({"soft_max_ext F32 + F16 mask", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * a = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 64, 8, 4);
+                         ggml_tensor * mask = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, 64, 8);
+                         in = {a, mask};
+                         return ggml_soft_max_ext(ctx, a, mask, 0.125f, 0.0f);
+                     }});
+    // KV cache writes (set_rows into F16 / quantized caches), as in every decode step
+    struct CacheType {
+        ggml_type type;
+        const char * name;
+    };
+    for (const CacheType & ct : {CacheType{GGML_TYPE_F16, "F16"}, CacheType{GGML_TYPE_Q8_0, "Q8_0"},
+                                 CacheType{GGML_TYPE_Q4_0, "Q4_0"}}) {
+        const ggml_type type = ct.type;
+        cases.push_back({std::string("set_rows F32->") + ct.name, [type](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                             ggml_tensor * dst = ggml_new_tensor_2d(ctx, type, 256, 64);
+                             ggml_tensor * src = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 256, 4);
+                             ggml_tensor * idx = ggml_new_tensor_1d(ctx, GGML_TYPE_I64, 4);
+                             in = {dst, src, idx};
+                             return ggml_set_rows(ctx, dst, src, idx);
+                         }});
+    }
+    // attention without flash attention: K is a permuted view of the F16 cache, V is stored transposed
+    cases.push_back({"mul_mat F16 K (permuted view) x Q", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * kt = ggml_new_tensor_3d(ctx, GGML_TYPE_F16, 64, 2, 32);  // head dim, kv heads, kv len
+                         ggml_tensor * q = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 64, 4, 8);    // head dim, tokens, heads
+                         in = {kt, q};
+                         return ggml_mul_mat(ctx, ggml_permute(ctx, kt, 0, 2, 1, 3), q);
+                     }});
+    cases.push_back({"mul_mat F16 V^T x KQ", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * v = ggml_new_tensor_3d(ctx, GGML_TYPE_F16, 32, 64, 2);   // kv len, head dim, kv heads
+                         ggml_tensor * kq = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 32, 4, 8);   // kv len, tokens, heads
+                         in = {v, kq};
+                         return ggml_mul_mat(ctx, v, kq);
+                     }});
+    // flash attention (used when the app's flash attention setting is on or auto)
+    cases.push_back({"flash_attn_ext F16 KV", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * q = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, 64, 4, 8, 1);
+                         ggml_tensor * k = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, 64, 32, 2, 1);
+                         ggml_tensor * v = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, 64, 32, 2, 1);
+                         ggml_tensor * mask = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, 32, 64, 1, 1);
+                         in = {q, k, v, mask};
+                         return ggml_flash_attn_ext(ctx, q, k, v, mask, 0.125f, 0.0f, 0.0f);
+                     }});
+
+    struct TypeName {
+        ggml_type type;
+        const char * name;
+    };
+    const TypeName types[] = {
+        {GGML_TYPE_F32, "F32"},     {GGML_TYPE_F16, "F16"},     {GGML_TYPE_Q4_0, "Q4_0"},
+        {GGML_TYPE_Q8_0, "Q8_0"},   {GGML_TYPE_Q4_K, "Q4_K"},   {GGML_TYPE_Q6_K, "Q6_K"},
+        {GGML_TYPE_Q2_K, "Q2_K"},   {GGML_TYPE_Q3_K, "Q3_K"},   {GGML_TYPE_Q5_K, "Q5_K"},
+        {GGML_TYPE_Q4_1, "Q4_1"},   {GGML_TYPE_Q5_0, "Q5_0"},   {GGML_TYPE_Q5_1, "Q5_1"},
+        {GGML_TYPE_IQ4_NL, "IQ4_NL"}, {GGML_TYPE_IQ4_XS, "IQ4_XS"}, {GGML_TYPE_IQ3_S, "IQ3_S"},
+    };
+    const int64_t batches[] = {1, 32};  // 1 = mat-vec shaders (generation), 32 = mat-mat (prompt)
+    for (const TypeName & tn : types) {
+        if (ggml_quantize_requires_imatrix(tn.type)) {
+            continue;  // can not be quantized for the test without an importance matrix
+        }
+        for (int64_t n : batches) {
+            const ggml_type type = tn.type;
+            std::string name = std::string("mul_mat ") + tn.name + " N=" + std::to_string(n);
+            cases.push_back({name, [type, n](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                                 ggml_tensor * w = ggml_new_tensor_2d(ctx, type, 512, 128);        // weights [K=512, M=128]
+                                 ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 512, n);  // activations [K, N]
+                                 in = {w, x};
+                                 return ggml_mul_mat(ctx, w, x);
+                             }});
+        }
+        // Embedding lookups (token_embd) run through get_rows, which is a separate shader per type.
+        const ggml_type type = tn.type;
+        cases.push_back({std::string("get_rows ") + tn.name, [type](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                             ggml_tensor * w = ggml_new_tensor_2d(ctx, type, 512, 64);
+                             ggml_tensor * idx = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 8);
+                             in = {w, idx};
+                             return ggml_get_rows(ctx, w, idx);
+                         }});
+    }
+
+    const size_t heavyStart = cases.size();
+    // ---- realistic sizes ----
+    // The small cases above can pass while wide rows, long contexts or odd batch sizes fail (reductions
+    // over thousands of columns, tile edges at N=13, ...). Dimensions follow a ~2B hybrid model with a
+    // 4k..16k context and a 13 token prompt.
+    for (int64_t cols : {2048, 4096}) {
+        const std::string tag = " F32 [" + std::to_string(cols) + ",13]";
+        cases.push_back({"rms_norm" + tag, [cols](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                             ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, cols, 13);
+                             in = {a};
+                             return ggml_rms_norm(ctx, a, 1e-5f);
+                         }});
+        cases.push_back({"rms_norm*weight (fused)" + tag, [cols](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                             ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, cols, 13);
+                             ggml_tensor * w = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, cols, 1);
+                             in = {a, w};
+                             return ggml_mul(ctx, ggml_rms_norm(ctx, a, 1e-5f), w);
+                         }});
+    }
+    cases.push_back({"swiglu F32 [16384,13]", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * a = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 16384, 13);
+                         in = {a};
+                         return ggml_swiglu(ctx, a);
+                     }});
+    for (int64_t cols : {2048, 4096, 16384}) {
+        cases.push_back({"soft_max_ext F32 [" + std::to_string(cols) + ",13,8] + F16 mask",
+                         [cols](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                             ggml_tensor * a = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, cols, 13, 8);
+                             ggml_tensor * mask = ggml_new_tensor_2d(ctx, GGML_TYPE_F16, cols, 13);
+                             in = {a, mask};
+                             return ggml_soft_max_ext(ctx, a, mask, 0.125f, 0.0f);
+                         }});
+    }
+    cases.push_back({"ssm_conv F32 d_inner=2048 n_t=13", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * sx = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 2 + 13, 2048, 1);
+                         ggml_tensor * c = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 3, 2048);
+                         in = {sx, c};
+                         return ggml_ssm_conv(ctx, sx, c);
+                     }});
+    for (int mode : {GGML_ROPE_TYPE_NORMAL, GGML_ROPE_TYPE_NEOX}) {
+        cases.push_back({mode == GGML_ROPE_TYPE_NEOX ? "rope neox F32 [128,32,13]" : "rope normal F32 [128,32,13]",
+                         [mode](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                             ggml_tensor * a = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 128, 32, 13);
+                             ggml_tensor * pos = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, 13);
+                             in = {a, pos};
+                             return ggml_rope_ext(ctx, a, pos, nullptr, 128, mode, 4096, 10000.0f, 1.0f, 0.0f, 1.0f,
+                                                  32.0f, 1.0f);
+                         }});
+    }
+    cases.push_back({"mul_mat F16 K (permuted) x Q, kv=4096", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * kt = ggml_new_tensor_3d(ctx, GGML_TYPE_F16, 64, 8, 4096);
+                         ggml_tensor * q = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 64, 13, 32);
+                         in = {kt, q};
+                         return ggml_mul_mat(ctx, ggml_permute(ctx, kt, 0, 2, 1, 3), q);
+                     }});
+    for (int64_t hs : {64, 128}) {
+        cases.push_back({"flash_attn_ext F16 KV head=" + std::to_string(hs) + " kv=4096",
+                         [hs](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                             ggml_tensor * q = ggml_new_tensor_4d(ctx, GGML_TYPE_F32, hs, 13, 32, 1);
+                             ggml_tensor * k = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, hs, 4096, 8, 1);
+                             ggml_tensor * v = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, hs, 4096, 8, 1);
+                             ggml_tensor * mask = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, 4096, 64, 1, 1);
+                             in = {q, k, v, mask};
+                             return ggml_flash_attn_ext(ctx, q, k, v, mask, 0.125f, 0.0f, 0.0f);
+                         }});
+    }
+    struct BigType {
+        ggml_type type;
+        const char * name;
+    };
+    struct BigShape {
+        int64_t k, m, n;
+    };
+    const BigType bigTypes[] = {
+        {GGML_TYPE_F16, "F16"}, {GGML_TYPE_Q4_0, "Q4_0"}, {GGML_TYPE_Q8_0, "Q8_0"}, {GGML_TYPE_Q4_K, "Q4_K"},
+    };
+    // K x M weights, N activation columns: hidden size 2048, FFN size 8192, prompt of 13 tokens
+    const BigShape bigShapes[] = {{2048, 2048, 1},  {2048, 2048, 13}, {2048, 2048, 64},
+                                  {8192, 1024, 1},  {8192, 1024, 13}, {2048, 8192, 13}};
+    for (const BigType & bt : bigTypes) {
+        for (const BigShape & sh : bigShapes) {
+            const ggml_type type = bt.type;
+            const int64_t k = sh.k, m = sh.m, n = sh.n;
+            cases.push_back({std::string("mul_mat ") + bt.name + " K=" + std::to_string(k) + " M=" + std::to_string(m) +
+                                 " N=" + std::to_string(n),
+                             [type, k, m, n](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                                 ggml_tensor * w = ggml_new_tensor_2d(ctx, type, k, m);
+                                 ggml_tensor * x = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, k, n);
+                                 in = {w, x};
+                                 return ggml_mul_mat(ctx, w, x);
+                             }});
+        }
+    }
+
+    for (size_t i = heavyStart; i < cases.size(); i++) {
+        cases[i].heavy = true;
+    }
+    // ---- pieces of the LFM3 graph (models/lfm-base.cpp): strided views, transpose, pad, state store ----
+    unary("sigmoid F32 [2048,13]", [](ggml_context * c, ggml_tensor * a) { return ggml_sigmoid(c, a); });
+    unary("gelu_erf F32 [2048,13]", [](ggml_context * c, ggml_tensor * a) { return ggml_gelu_erf(c, a); });
+    cases.push_back({"pad_ext right 2 (dim 0) F32", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * a = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 13, 2048, 1);
+                         in = {a};
+                         return ggml_pad_ext(ctx, a, 0, 2, 0, 0, 0, 0, 0, 0);
+                     }});
+    cases.push_back({"pad_ext left 2 (dim 0) F32", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * a = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 13, 2048, 1);
+                         in = {a};
+                         return ggml_pad_ext(ctx, a, 2, 0, 0, 0, 0, 0, 0, 0);
+                     }});
+    for (int64_t n_tok : {1, 13}) {
+        const std::string tag = " n_tokens=" + std::to_string(n_tok);
+        // b, c and x are strided views of one {3*n_embd, n_tokens} tensor
+        cases.push_back({"mul of two strided views" + tag, [n_tok](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                             const int64_t n_embd = 2048;
+                             ggml_tensor * bcx = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 3 * n_embd, n_tok, 1);
+                             in = {bcx};
+                             ggml_tensor * b = ggml_view_3d(ctx, bcx, n_embd, n_tok, 1, bcx->nb[1], bcx->nb[2],
+                                                            0 * n_embd * ggml_element_size(bcx));
+                             ggml_tensor * x = ggml_view_3d(ctx, bcx, n_embd, n_tok, 1, bcx->nb[1], bcx->nb[2],
+                                                            2 * n_embd * ggml_element_size(bcx));
+                             return ggml_mul(ctx, b, x);
+                         }});
+        cases.push_back({"concat(state, transpose(mul(b,x)))" + tag,
+                         [n_tok](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                             const int64_t n_embd = 2048;
+                             ggml_tensor * bcx = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 3 * n_embd, n_tok, 1);
+                             ggml_tensor * state = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 2, n_embd, 1);
+                             in = {bcx, state};
+                             ggml_tensor * b = ggml_view_3d(ctx, bcx, n_embd, n_tok, 1, bcx->nb[1], bcx->nb[2],
+                                                            0 * n_embd * ggml_element_size(bcx));
+                             ggml_tensor * x = ggml_view_3d(ctx, bcx, n_embd, n_tok, 1, bcx->nb[1], bcx->nb[2],
+                                                            2 * n_embd * ggml_element_size(bcx));
+                             return ggml_concat(ctx, state, ggml_transpose(ctx, ggml_mul(ctx, b, x)), 0);
+                         }});
+        // the whole causal short convolution as in build_lfm_shortconv()
+        cases.push_back({"LFM shortconv subgraph" + tag, [n_tok](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                             const int64_t n_embd = 2048;
+                             ggml_tensor * bcx = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 3 * n_embd, n_tok, 1);
+                             ggml_tensor * state = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 2, n_embd, 1);
+                             ggml_tensor * kernel = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, 3, n_embd);
+                             in = {bcx, state, kernel};
+                             ggml_tensor * b = ggml_view_3d(ctx, bcx, n_embd, n_tok, 1, bcx->nb[1], bcx->nb[2],
+                                                            0 * n_embd * ggml_element_size(bcx));
+                             ggml_tensor * c = ggml_view_3d(ctx, bcx, n_embd, n_tok, 1, bcx->nb[1], bcx->nb[2],
+                                                            1 * n_embd * ggml_element_size(bcx));
+                             ggml_tensor * x = ggml_view_3d(ctx, bcx, n_embd, n_tok, 1, bcx->nb[1], bcx->nb[2],
+                                                            2 * n_embd * ggml_element_size(bcx));
+                             ggml_tensor * bx = ggml_transpose(ctx, ggml_mul(ctx, b, x));
+                             bx = ggml_concat(ctx, state, bx, 0);
+                             ggml_tensor * conv_out = ggml_ssm_conv(ctx, bx, kernel);
+                             return ggml_mul(ctx, c, conv_out);
+                         }});
+    }
+    // build_conv_state_store(): the last columns of the concatenated tensor are copied into the state
+    cases.push_back({"cpy strided view -> conv state", [](ggml_context * ctx, std::vector<ggml_tensor *> & in) {
+                         ggml_tensor * bx = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 15, 2048, 1);
+                         ggml_tensor * dst = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, 2, 2048, 1);
+                         in = {bx};
+                         ggml_tensor * last = ggml_view_3d(ctx, bx, 2, 2048, 1, bx->nb[1], bx->nb[2],
+                                                           13 * ggml_element_size(bx));
+                         return ggml_cpy(ctx, last, dst);
+                     }});
+    return cases;
+}
+
+// Written before every case, so that if the driver kills the app (device lost, exit() inside the
+// driver) the report in Settings still ends with the case that was running.
+void writeReport(const std::string & report, const char * runningCase) {
+    const char * dir = getenv("RNLLAMA_VK_DRIVER_DIR");
+    if (dir == nullptr || *dir == '\0') {
+        return;
+    }
+    const std::string path = std::string(dir) + "/selftest.txt";
+    if (FILE * f = fopen(path.c_str(), "wb")) {
+        fwrite(report.data(), 1, report.size(), f);
+        if (runningCase != nullptr) {
+            std::string tail = std::string(">> running (the app died here if this is the last line): ") + runningCase + "\n";
+            fwrite(tail.data(), 1, tail.size(), f);
+        }
+        fflush(f);
+        fsync(fileno(f));
+        fclose(f);
+    }
+}
+
+bool nameInEnvList(const char * envName, const std::string & name) {
+    const char * env = getenv(envName);
+    if (env == nullptr || *env == '\0') {
+        return false;
+    }
+    std::string list = env;
+    size_t start = 0;
+    while (start <= list.size()) {
+        size_t end = list.find(',', start);
+        if (end == std::string::npos) {
+            end = list.size();
+        }
+        const std::string part = list.substr(start, end - start);
+        if (!part.empty() && name.find(part) != std::string::npos) {
+            return true;
+        }
+        start = end + 1;
+    }
+    return false;
+}
+
+void emit(std::string & report, const char * line) {
+    __android_log_print(ANDROID_LOG_INFO, "RNLlamaVk", "selftest: %s", line);
+    report += line;
+    report += "\n";
+}
+
+}  // namespace
+
+extern "C" void rnllama_vk_selftest_run() {
+    static bool started = false;  // runs once per process; also stops the re-entry through backend creation
+    if (started) {
+        return;
+    }
+    started = true;
+
+    std::string report;
+    try {
+        ggml_backend_dev_t gpu = nullptr;
+        ggml_backend_dev_t cpu = nullptr;
+        for (size_t i = 0; i < ggml_backend_dev_count(); i++) {
+            ggml_backend_dev_t dev = ggml_backend_dev_get(i);
+            const char * name = ggml_backend_dev_name(dev);
+            const enum ggml_backend_dev_type type = ggml_backend_dev_type(dev);
+            if (gpu == nullptr && name != nullptr && strncmp(name, "Vulkan", 6) == 0) {
+                gpu = dev;
+            }
+            if (cpu == nullptr && type == GGML_BACKEND_DEVICE_TYPE_CPU) {
+                cpu = dev;
+            }
+        }
+        if (gpu == nullptr || cpu == nullptr) {
+            emit(report, "No Vulkan (or CPU) backend device is registered.");
+        } else {
+            char line[256];
+            const char * desc = ggml_backend_dev_description(gpu);
+            snprintf(line, sizeof(line), "GPU: %s", desc != nullptr ? desc : "?");
+            emit(report, line);
+            const char * levelEnv = getenv("RNLLAMA_VK_SELFTEST");
+            const int level = levelEnv != nullptr ? atoi(levelEnv) : 1;
+            snprintf(line, sizeof(line), "Level %d (%s). Normalised error of GPU vs CPU (OK < 0.002):", level,
+                     level >= 2 ? "including realistic-size cases" : "basic cases only");
+            emit(report, line);
+            ggml_backend_t beCpu = ggml_backend_dev_init(cpu, nullptr);
+            ggml_backend_t beGpu = ggml_backend_dev_init(gpu, nullptr);
+            int nOk = 0, nWarn = 0, nBad = 0, nSkip = 0;
+            if (beCpu == nullptr || beGpu == nullptr) {
+                emit(report, "Could not initialise a backend.");
+            } else {
+                for (const SelfTestCase & c : makeSelfTestCases()) {
+                    if (c.heavy && level < 2) {
+                        continue;
+                    }
+                    if (nameInEnvList("RNLLAMA_VK_SELFTEST_SKIP", c.name)) {
+                        continue;
+                    }
+                    const char * onlyEnv = getenv("RNLLAMA_VK_SELFTEST_ONLY");
+                    if (onlyEnv != nullptr && *onlyEnv != '\0' && !nameInEnvList("RNLLAMA_VK_SELFTEST_ONLY", c.name)) {
+                        continue;
+                    }
+                    writeReport(report, c.name.c_str());
+                    __android_log_print(ANDROID_LOG_INFO, "RNLlamaVk", "selftest: running %s", c.name.c_str());
+                    std::vector<float> ref, got;
+                    const int rc = runSelfTestCase(beCpu, c, ref);
+                    const int gc = runSelfTestCase(beGpu, c, got);
+                    if (gc < 0 || rc <= 0) {
+                        snprintf(line, sizeof(line), "%s: skipped (%s)", c.name.c_str(),
+                                 gc < 0 ? "GPU does not support this op" : "CPU reference failed");
+                        nSkip++;
+                    } else if (gc == 0 || got.size() != ref.size()) {
+                        snprintf(line, sizeof(line), "%s: BAD (GPU compute failed)", c.name.c_str());
+                        nBad++;
+                    } else {
+                        double num = 0.0, den = 0.0;
+                        size_t nonFinite = 0;
+                        for (size_t i = 0; i < ref.size(); i++) {
+                            if (!std::isfinite(got[i])) {
+                                nonFinite++;
+                                continue;
+                            }
+                            const double d = (double) got[i] - (double) ref[i];
+                            num += d * d;
+                            den += (double) ref[i] * (double) ref[i];
+                        }
+                        const double nmse = den > 0.0 ? num / den : num;
+                        const char * verdict = (nonFinite > 0 || nmse > 5e-2) ? "BAD" : (nmse > 2e-3 ? "WARN" : "OK");
+                        if (verdict[0] == 'B') {
+                            nBad++;
+                        } else if (verdict[0] == 'W') {
+                            nWarn++;
+                        } else {
+                            nOk++;
+                        }
+                        snprintf(line, sizeof(line), "%s: %s (err %.2e%s)", c.name.c_str(), verdict, nmse,
+                                 nonFinite > 0 ? ", NaN/Inf present" : "");
+                    }
+                    emit(report, line);
+                }
+                snprintf(line, sizeof(line), "Summary: %d OK, %d WARN, %d BAD, %d skipped", nOk, nWarn, nBad, nSkip);
+                emit(report, line);
+            }
+            if (beGpu != nullptr) {
+                ggml_backend_free(beGpu);
+            }
+            if (beCpu != nullptr) {
+                ggml_backend_free(beCpu);
+            }
+        }
+    } catch (const std::exception & e) {
+        emit(report, (std::string("Self-test aborted: ") + e.what()).c_str());
+    } catch (...) {
+        emit(report, "Self-test aborted by an unknown error.");
+    }
+
+    writeReport(report, nullptr);
+}
