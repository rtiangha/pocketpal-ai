+# Replacement for upstream libadrenotools' top-level CMakeLists.txt.
+# linkernsbypass is provided by the caller (target `linkernsbypass` must already exist).
+if (NOT TARGET linkernsbypass)
+    message(FATAL_ERROR "libadrenotools: target linkernsbypass must be defined by the caller")
+endif ()
+
+set(LIB_SOURCES src/bcenabler.cpp src/driver.cpp)
+
+add_library(adrenotools STATIC ${LIB_SOURCES})
+set_target_properties(adrenotools PROPERTIES POSITION_INDEPENDENT_CODE ON)
+target_include_directories(adrenotools PUBLIC include)
+target_include_directories(adrenotools PRIVATE .)
+target_link_libraries(adrenotools PUBLIC android log linkernsbypass)
+
+add_subdirectory(src/hook)
