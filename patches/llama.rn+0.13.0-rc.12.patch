+# Vulkan (+ libadrenotools / Turnip) support for the rnllama Android variants whose
+# name ends in `_vulkan`.  Included from android/src/main/rnllama/CMakeLists.txt.
+#
+# What this does, because llama.cpp's own ggml-vulkan/CMakeLists.txt can not be used
+# (llama.rn compiles the ggml sources straight into its variants instead of calling
+# ggml's CMake project):
+#   1. fetches the header-only dependencies (Vulkan-Headers, SPIRV-Headers).  Needs network
+#      access at configure time unless FETCHCONTENT_SOURCE_DIR_<NAME> points at a local copy.
+#      libadrenotools and liblinkernsbypass are vendored in third_party/.
+#   2. builds vulkan-shaders-gen for the HOST and runs it with the NDK's glslc to turn
+#      vulkan-shaders/*.comp into C++ sources (same procedure as upstream ggml-vulkan).
+#   3. adds the ggml-vulkan sources + generated shader sources to the variant.
+#   4. builds libadrenotools (static) and its hook libraries (hook_impl, main_hook,
+#      file_redirect_hook, gsl_alloc_hook).  The hook libraries must end up in the app's
+#      nativeLibraryDir, which needs android:extractNativeLibs / useLegacyPackaging.
+#
+# Optional shader extensions (cooperative matrix, integer dot, bf16, fp4/fp8) are left
+# off: the Adreno 6xx class this targets does not use them, and it keeps the generated
+# shader count (and build time) down.
+include_guard(GLOBAL)
+
+include(FetchContent)
+include(ExternalProject)
+
+set(RNLLAMA_VULKAN_HEADERS_TAG "vulkan-sdk-1.4.363.0" CACHE STRING "Vulkan-Headers git tag/branch (needs vulkan.hpp)")
+set(RNLLAMA_SPIRV_HEADERS_TAG  "vulkan-sdk-1.4.363.0" CACHE STRING "SPIRV-Headers git tag/branch")
+set(RNLLAMA_GLSLC "" CACHE FILEPATH "glslc executable (defaults to the one shipped in the NDK)")
+
+set(FETCHCONTENT_QUIET OFF)
+set(FETCHCONTENT_UPDATES_DISCONNECTED ON)
+
+function(rnllama_vulkan_configure target_name variant_objects)
+    set(vk_dir ${RNLLAMA_GGML_VULKAN_DIR})
+    set(adreno_dir ${RNLLAMA_ROOT_DIR}/third_party/libadrenotools)
+
+    # The llama.rn npm package does not ship ggml-vulkan. The app's postinstall step
+    # (scripts/fetch-ggml-vulkan.sh) downloads it from the pinned llama.cpp commit and applies
+    # the driver-loading edits to it.
+    if (NOT EXISTS ${vk_dir}/ggml-vulkan.cpp)
+        message(FATAL_ERROR "rnllama Vulkan: ${vk_dir} is missing. The llama.rn npm package does "
+                            "not ship it; run scripts/fetch-ggml-vulkan.sh (scripts/postinstall.sh does).")
+    endif ()
+    file(STRINGS ${vk_dir}/ggml-vulkan.cpp rnllama_vk_edit_marker REGEX "ggml_vk_get_instance_proc_addr" LIMIT_COUNT 1)
+    if (NOT rnllama_vk_edit_marker)
+        message(FATAL_ERROR "rnllama Vulkan: ${vk_dir} does not have the driver-loading edits. "
+                            "Run scripts/fetch-ggml-vulkan.sh.")
+    endif ()
+
+    # ---- 1. dependencies ------------------------------------------------------------
+    get_property(deps_ready GLOBAL PROPERTY RNLLAMA_VULKAN_DEPS_READY)
+    if (NOT deps_ready)
+        FetchContent_Declare(rnllama_vulkan_headers
+            GIT_REPOSITORY https://github.com/KhronosGroup/Vulkan-Headers.git
+            GIT_TAG ${RNLLAMA_VULKAN_HEADERS_TAG}
+            GIT_SHALLOW TRUE)
+        FetchContent_Declare(rnllama_spirv_headers
+            GIT_REPOSITORY https://github.com/KhronosGroup/SPIRV-Headers.git
+            GIT_TAG ${RNLLAMA_SPIRV_HEADERS_TAG}
+            GIT_SHALLOW TRUE)
+
+        # Only the include directories are used; do not let the subprojects add targets
+        # that would end up in the default build.
+        FetchContent_GetProperties(rnllama_vulkan_headers)
+        if (NOT rnllama_vulkan_headers_POPULATED)
+            FetchContent_Populate(rnllama_vulkan_headers)
+        endif ()
+        FetchContent_GetProperties(rnllama_spirv_headers)
+        if (NOT rnllama_spirv_headers_POPULATED)
+            FetchContent_Populate(rnllama_spirv_headers)
+        endif ()
+
+        set_property(GLOBAL PROPERTY RNLLAMA_VULKAN_HEADERS_DIR ${rnllama_vulkan_headers_SOURCE_DIR}/include)
+        set_property(GLOBAL PROPERTY RNLLAMA_SPIRV_HEADERS_DIR  ${rnllama_spirv_headers_SOURCE_DIR}/include)
+
+        # linkernsbypass + libadrenotools (static lib + hook shared libs)
+        set(GEN_INSTALL_TARGET OFF CACHE BOOL "" FORCE)
+        set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+        add_subdirectory(${adreno_dir}/lib/linkernsbypass
+                         ${CMAKE_CURRENT_BINARY_DIR}/linkernsbypass)
+        add_subdirectory(${adreno_dir} ${CMAKE_CURRENT_BINARY_DIR}/libadrenotools)
+
+        set_property(GLOBAL PROPERTY RNLLAMA_VULKAN_DEPS_READY TRUE)
+    endif ()
+    get_property(vulkan_headers_dir GLOBAL PROPERTY RNLLAMA_VULKAN_HEADERS_DIR)
+    get_property(spirv_headers_dir  GLOBAL PROPERTY RNLLAMA_SPIRV_HEADERS_DIR)
+
+    # ---- 2. glslc + host shader generator ---------------------------------------------
+    if (NOT RNLLAMA_GLSLC)
+        set(ndk_root "")
+        if (ANDROID_NDK)
+            set(ndk_root "${ANDROID_NDK}")
+        elseif (CMAKE_ANDROID_NDK)
+            set(ndk_root "${CMAKE_ANDROID_NDK}")
+        endif ()
+        file(GLOB glslc_candidates "${ndk_root}/shader-tools/*/glslc")
+        set(glslc_hint_dirs "")
+        foreach (candidate ${glslc_candidates})
+            get_filename_component(candidate_dir ${candidate} DIRECTORY)
+            list(APPEND glslc_hint_dirs ${candidate_dir})
+        endforeach ()
+        find_program(RNLLAMA_GLSLC_FOUND NAMES glslc HINTS ${glslc_hint_dirs} NO_CMAKE_FIND_ROOT_PATH)
+        set(RNLLAMA_GLSLC "${RNLLAMA_GLSLC_FOUND}")
+    endif ()
+    if (NOT RNLLAMA_GLSLC)
+        message(FATAL_ERROR "rnllama Vulkan: glslc not found. Install the NDK shader-tools "
+                            "or pass -DRNLLAMA_GLSLC=/path/to/glslc")
+    endif ()
+    message(STATUS "rnllama Vulkan: glslc = ${RNLLAMA_GLSLC}")
+
+    if (CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
+        find_program(HOST_C_COMPILER   NAMES cl gcc clang   NO_CMAKE_FIND_ROOT_PATH)
+        find_program(HOST_CXX_COMPILER NAMES cl g++ clang++ NO_CMAKE_FIND_ROOT_PATH)
+    else ()
+        find_program(HOST_C_COMPILER   NAMES gcc clang   NO_CMAKE_FIND_ROOT_PATH)
+        find_program(HOST_CXX_COMPILER NAMES g++ clang++ NO_CMAKE_FIND_ROOT_PATH)
+    endif ()
+    if (NOT HOST_C_COMPILER OR NOT HOST_CXX_COMPILER)
+        message(FATAL_ERROR "rnllama Vulkan: no host C/C++ compiler found for vulkan-shaders-gen")
+    endif ()
+    message(STATUS "rnllama Vulkan: host compiler ${HOST_C_COMPILER} / ${HOST_CXX_COMPILER}")
+
+    set(host_toolchain ${CMAKE_BINARY_DIR}/rnllama-vulkan-host-toolchain.cmake)
+    configure_file(${vk_dir}/cmake/host-toolchain.cmake.in ${host_toolchain} @ONLY)
+
+    set(genshaders_dir ${CMAKE_BINARY_DIR}/rnllama-vulkan-shaders-gen)
+    if (NOT TARGET vulkan-shaders-gen)
+        ExternalProject_Add(
+            vulkan-shaders-gen
+            SOURCE_DIR ${vk_dir}/vulkan-shaders
+            CMAKE_ARGS -DCMAKE_INSTALL_PREFIX=${genshaders_dir}
+                       -DCMAKE_INSTALL_BINDIR=.
+                       -DCMAKE_BUILD_TYPE=Release
+                       -DCMAKE_TOOLCHAIN_FILE=${host_toolchain}
+            BUILD_COMMAND ${CMAKE_COMMAND} --build . --config Release
+            BUILD_ALWAYS  TRUE
+            INSTALL_COMMAND ${CMAKE_COMMAND} -E env --unset=DESTDIR
+                            ${CMAKE_COMMAND} --install . --config Release
+        )
+    endif ()
+
+    # ---- 3. generated shaders + backend sources ---------------------------------------
+    set(genshaders_cmd ${genshaders_dir}/vulkan-shaders-gen)
+    set(shader_header  ${CMAKE_CURRENT_BINARY_DIR}/ggml-vulkan-shaders.hpp)
+    set(shader_input   ${vk_dir}/vulkan-shaders)
+    set(shader_spv_out ${CMAKE_CURRENT_BINARY_DIR}/vulkan-shaders.spv)
+
+    file(GLOB shader_files CONFIGURE_DEPENDS "${shader_input}/*.comp")
+    file(GLOB shader_gen_sources CONFIGURE_DEPENDS "${shader_input}/*.cpp" "${shader_input}/*.h")
+
+    add_custom_command(
+        OUTPUT ${shader_header}
+        COMMAND ${genshaders_cmd} --output-dir ${shader_spv_out} --target-hpp ${shader_header}
+        DEPENDS ${shader_gen_sources} vulkan-shaders-gen
+        COMMENT "Generate vulkan shaders header"
+    )
+    set(generated_sources ${shader_header})
+
+    foreach (shader_full ${shader_files})
+        get_filename_component(shader_name ${shader_full} NAME)
+        set(shader_cpp ${CMAKE_CURRENT_BINARY_DIR}/${shader_name}.cpp)
+        add_custom_command(
+            OUTPUT  ${shader_cpp}
+            DEPFILE ${shader_cpp}.d
+            COMMAND ${genshaders_cmd}
+                    --glslc      ${RNLLAMA_GLSLC}
+                    --source     ${shader_full}
+                    --output-dir ${shader_spv_out}
+                    --target-hpp ${shader_header}
+                    --target-cpp ${shader_cpp}
+            DEPENDS ${shader_full} ${shader_gen_sources} vulkan-shaders-gen
+            COMMENT "Generate vulkan shaders for ${shader_name}"
+        )
+        list(APPEND generated_sources ${shader_cpp})
+    endforeach ()
+
+    target_sources(${variant_objects} PRIVATE
+        ${vk_dir}/ggml-vulkan.cpp
+        ${vk_dir}/ggml-vulkan-buffers.cpp
+        ${vk_dir}/ggml-vulkan-comm.cpp
+        ${vk_dir}/ggml-vulkan-debug.cpp
+        ${CMAKE_CURRENT_SOURCE_DIR}/vk-selftest.cpp
+        ${generated_sources}
+    )
+    target_include_directories(${variant_objects} BEFORE PRIVATE
+        ${vulkan_headers_dir}
+        ${spirv_headers_dir}
+    )
+    target_include_directories(${variant_objects} PRIVATE
+        ${CMAKE_CURRENT_BINARY_DIR}
+        ${adreno_dir}/include
+    )
+    target_compile_options(${variant_objects} PRIVATE
+        -DGGML_USE_VULKAN
+        -DRNLLAMA_ADRENOTOOLS
+    )
+
+    # ---- 4. link ----------------------------------------------------------------------
+    target_link_libraries(${target_name} PRIVATE vulkan adrenotools)
+    message(STATUS "rnllama Vulkan backend enabled for ${target_name}")
+endfunction()
