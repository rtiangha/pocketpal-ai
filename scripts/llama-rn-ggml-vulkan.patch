+// Keeps <RNLLAMA_VK_DRIVER_DIR>/last_pipeline.txt up to date with the shaders the driver is compiling right
+// now. If the driver kills the app inside its shader compiler (it calls exit() on some failures), the file
+// still names the shader(s) that were being compiled; Settings shows it. RNLLAMA_VK_LOG_PIPELINES=1 also
+// logs every compile to logcat.
+static void rnllama_vk_pipeline_mark(const std::string & name, bool begin) {
+    static const char * dir = getenv("RNLLAMA_VK_DRIVER_DIR");
+    static const bool log_all = getenv("RNLLAMA_VK_LOG_PIPELINES") != nullptr;
+    static std::mutex mtx;
+    static std::set<std::string> in_flight;
+    if (dir == nullptr || *dir == '\0') {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(mtx);
+    if (begin) {
+        in_flight.insert(name);
+        if (log_all) {
+            RNLLAMA_VK_ALOG(INFO, "compiling pipeline %s", name.c_str());
+        }
+    } else {
+        in_flight.erase(name);
+    }
+    const std::string path = std::string(dir) + "/last_pipeline.txt";
+    if (FILE * f = fopen(path.c_str(), "wb")) {
+        if (in_flight.empty()) {
+            fputs("ok\n", f);
+        } else {
+            for (const auto & n : in_flight) {
+                fprintf(f, "compiling %s\n", n.c_str());
+            }
+        }
+        fclose(f);
+    }
+}
+#else
+static void rnllama_vk_pipeline_mark(const std::string &, bool) {}
+#endif
