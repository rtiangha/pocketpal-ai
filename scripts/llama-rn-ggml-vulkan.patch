+// rnllama: choose the Vulkan loader.
+//
+// With RNLLAMA_VK_DRIVER_DIR / RNLLAMA_VK_DRIVER_NAME / RNLLAMA_VK_HOOK_DIR set (RNLlama.java does
+// this when the user enabled a custom driver) a Vulkan loader is opened through libadrenotools so
+// that it loads the custom driver (e.g. Mesa Turnip) instead of the system one. Everything else in
+// this file then has to go through that loader's vkGetInstanceProcAddr, never the linked symbol.
+PFN_vkGetInstanceProcAddr ggml_vk_get_instance_proc_addr() {
+    static PFN_vkGetInstanceProcAddr gipa = []() -> PFN_vkGetInstanceProcAddr {
+#ifdef RNLLAMA_ADRENOTOOLS
+        const char * drv_dir  = getenv("RNLLAMA_VK_DRIVER_DIR");
+        const char * drv_name = getenv("RNLLAMA_VK_DRIVER_NAME");
+        const char * hook_dir = getenv("RNLLAMA_VK_HOOK_DIR");
+        const char * tmp_dir  = getenv("RNLLAMA_VK_TMP_DIR");
+        RNLLAMA_VK_ALOG(INFO, "driver env: dir=%s name=%s hooks=%s tmp=%s",
+                        drv_dir ? drv_dir : "(unset)", drv_name ? drv_name : "(unset)",
+                        hook_dir ? hook_dir : "(unset)", tmp_dir ? tmp_dir : "(unset)");
+        if (drv_dir && drv_dir[0] && drv_name && drv_name[0] && hook_dir && hook_dir[0]) {
+            std::string dir = drv_dir;
+            if (dir.back() != '/') {
+                dir += '/';
+            }
+            GGML_LOG_INFO("ggml_vulkan: opening custom driver %s%s via libadrenotools (hooks: %s)\n",
+                          dir.c_str(), drv_name, hook_dir);
+            void * handle = adrenotools_open_libvulkan(RTLD_NOW | RTLD_LOCAL, ADRENOTOOLS_DRIVER_CUSTOM,
+                                                       (tmp_dir && tmp_dir[0]) ? tmp_dir : nullptr,
+                                                       hook_dir, dir.c_str(), drv_name, nullptr, nullptr);
+            RNLLAMA_VK_ALOG(INFO, "adrenotools_open_libvulkan returned %p", handle);
+            if (handle != nullptr) {
+                auto fn = (PFN_vkGetInstanceProcAddr) dlsym(handle, "vkGetInstanceProcAddr");
+                RNLLAMA_VK_ALOG(INFO, "custom loader vkGetInstanceProcAddr = %p", (void *) fn);
+                if (fn != nullptr) {
+                    return fn;
+                }
+                GGML_LOG_ERROR("ggml_vulkan: custom driver loader has no vkGetInstanceProcAddr, using the system driver\n");
+            } else {
+                GGML_LOG_ERROR("ggml_vulkan: adrenotools_open_libvulkan failed, using the system driver\n");
+            }
+        }
+#endif
+        RNLLAMA_VK_ALOG(WARN, "using the system Vulkan loader");
+        return vkGetInstanceProcAddr;
+    }();
+    return gipa;
+}
+
+// rnllama: comma separated, case insensitive name lists from the environment, used to make the backend
+// refuse some work so the CPU does it instead (workarounds for drivers that miscompute it):
+//   GGML_VK_UNSUPPORTED_TYPES=Q6_K,...  matrix multiplications with weights of those types
+//                                       (e.g. Q6_K on Turnip / Adreno 660)
+//   GGML_VK_UNSUPPORTED_OPS=SSM_CONV,... ops by ggml name (ggml_op_desc), e.g. SSM_CONV, SOFT_MAX,
+//                                       FLASH_ATTN_EXT, ROPE, RMS_NORM, SILU
+static std::vector<std::string> ggml_vk_parse_env_list(const char * name) {
+    std::vector<std::string> out;
+    const char * env = getenv(name);
+    if (env == nullptr) {
+        return out;
+    }
+    std::string cur;
+    for (const char * c = env;; ++c) {
+        if (*c == ',' || *c == ';' || *c == ' ' || *c == '\0') {
+            if (!cur.empty()) {
+                out.push_back(cur);
+                cur.clear();
+            }
+            if (*c == '\0') {
+                break;
+            }
+        } else {
+            cur += (char) toupper((unsigned char) *c);
+        }
+    }
+    return out;
+}
+
+static bool ggml_vk_name_in_list(const std::vector<std::string> & names, const char * value) {
+    if (names.empty() || value == nullptr) {
+        return false;
+    }
+    std::string upper = value;
+    for (auto & ch : upper) {
+        ch = (char) toupper((unsigned char) ch);
+    }
+    for (const auto & n : names) {
+        if (n == upper) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool ggml_vk_type_unsupported_by_env(ggml_type type) {
+    static const std::vector<std::string> names = ggml_vk_parse_env_list("GGML_VK_UNSUPPORTED_TYPES");
+    return ggml_vk_name_in_list(names, ggml_type_name(type));
+}
+
+static bool ggml_vk_op_unsupported_by_env(const ggml_tensor * op) {
+    static const std::vector<std::string> names = ggml_vk_parse_env_list("GGML_VK_UNSUPPORTED_OPS");
+    return ggml_vk_name_in_list(names, ggml_op_desc(op));
+}
